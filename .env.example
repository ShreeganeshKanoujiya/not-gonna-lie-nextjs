# Database connection string for MongoDB. Keep real values in .env only.
MONGODB_URI=""

# NextAuth secret for session encryption. Keep real values in .env only.
NEXTAUTH_SECRET=""

# SMTP credentials for verification emails. Keep real values in .env only.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
MAIL_FROM="Not Gonna Lie <no-reply@example.com>"
